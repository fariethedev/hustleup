{
  "expo": {
    "name": "HustleSpace",
    "slug": "hustlespace",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hustlespace",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "space.hustlespace.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#CDFF00",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "space.hustlespace.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#CDFF00",
          "dark": {
            "backgroundColor": "#CDFF00"
          }
        }
      ],
      "@sentry/react-native",
      [
        "expo-notifications",
        {
          "color": "#CDFF00"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-video",
      "expo-audio"
    ],
    "extra": {
      "apiBaseUrl": "https://api.hustlespace.space/api/v1",
      "sentryDsn": "",
      "googleClientId": "",
      "facebookAppId": ""
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
