{
  "cli": { "appVersionSource": "remote" },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_API_URL": "https://api.hustlespace.space/api/v1" }
    },
    "ios-simulator": { "extends": "preview", "ios": { "simulator": true } },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_API_URL": "https://api.hustlespace.space/api/v1" }
    }
  }
}
