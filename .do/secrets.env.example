# Copy to .do/secrets.env (gitignored) and fill in PRODUCTION values — the ones set on
# Railway today, not the localhost values in backend/.env. Then run:
#   node scripts/do-render-spec.mjs
# Blank optional values are dropped from the rendered spec so each service falls back to
# its application.yml default. Database credentials are NOT here: App Platform injects
# them from the managed MySQL cluster.

# ── Required ──────────────────────────────────────────────
JWT_SECRET=
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
EMAIL_FROM=

# ── Optional ──────────────────────────────────────────────
# Comma-prefixed extra origins appended after the app URL, e.g. ",https://hustlespace.space"
EXTRA_CORS_ORIGINS=
RESEND_API_KEY=
SENTRY_DSN=
CDN_DOMAIN=
STRIPE_PLATFORM_FEE_PERCENT=
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TURNSTILE_SECRET_KEY=
GOOGLE_MAPS_SERVER_KEY=
ALGOLIA_APP_ID=
ALGOLIA_ADMIN_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
R2_IMAGES_ENABLED=
R2_ENDPOINT=
R2_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BASE_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── Web build (public, baked into the JS bundle) ─────────
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_TURNSTILE_SITE_KEY=
VITE_ALGOLIA_SEARCH_KEY=
VITE_SENTRY_DSN=
VITE_CRISP_WEBSITE_ID=
