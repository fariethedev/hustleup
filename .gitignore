# ── Environment & Secrets ────────────────────────────────
.env
.env.*
!.env.example
*.local

# ── Cryptographic Keys ──────────────────────────────────
*.key
*.pem
*.p12
*.jks
*.keystore

# ── Logs & Error Files ──────────────────────────────────
*.log
*.err
*.log.err
*log.txt

# ── Temporary & Uploads ──────────────────────────────────
backend/uploads/
# Service-local upload directories are runtime data too; keep them out of Git.
backend/**/uploads/
# Database exports may contain personal or transactional data and belong in
# protected backup storage, not in the source repository.
db_backup/
# Root-level uploads/ was NOT covered by the line above — user-uploaded images were
# sitting untracked and would have been swept into the first `git add` that touched
# the repo root. Uploads belong in S3, never in git.
uploads/
/.expo/
/.browser-review/
/artifacts/ui-review/
/mobile/dist-review/
# Separate review prototype repository; keep its history independent.
hustup-test/

# Local review screenshots / browser profiles (large, machine-specific)
artifacts/
swerrv-history-before-secret-redaction.bundle
swerrv-clothingbrand-website/
hs_err_pid*.log

# DigitalOcean: real secrets and the spec rendered from them
.do/secrets.env
.do/app.rendered.yaml
