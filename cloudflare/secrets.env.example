# Copy to cloudflare/.secrets.env (gitignored), fill in PRODUCTION values, then upload:
#   cd cloudflare && npx wrangler secret bulk .secrets.env
# Blank values are ignored by the Worker, so each service keeps its application.yml default.

# ── Database (Aiven free MySQL: Service → Overview → Connection information) ──
# jdbc:mysql://<host>:<port>/defaultdb?sslMode=REQUIRED&serverTimezone=UTC
DB_URL=
DB_USERNAME=avnadmin
DB_PASSWORD=

# ── Required ─────────────────────────────────────────────
JWT_SECRET=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=HustleSpace <notifications@hustlespace.space>

# ── Optional ─────────────────────────────────────────────
SENTRY_DSN=
CDN_DOMAIN=
STRIPE_PLATFORM_FEE_PERCENT=
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TURNSTILE_SECRET_KEY=
GOOGLE_MAPS_SERVER_KEY=
ALGOLIA_APP_ID=
ALGOLIA_ADMIN_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
R2_IMAGES_ENABLED=
R2_ENDPOINT=
R2_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BASE_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
