# HustleUp Environment Configuration
# Copy this file to .env and fill in your values
# Then set these as environment variables before starting the backend services

# ── Database ──────────────────────────────────────────────
MYSQL_PASSWORD=your-mysql-password-here

# ── JWT Authentication ────────────────────────────────────
# Must be at least 32 characters (256 bits) for HS256
JWT_SECRET=your-jwt-secret-here-must-be-at-least-32-chars

# ── AWS S3 (optional — leave blank for local file storage) ─
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=hustle-up

# ── Stripe Payments ──────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your-stripe-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_your-connect-webhook-secret-here

# ── Frontend URL ─────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── CORS (gateway) ───────────────────────────────────────
# Comma-separated list of origins allowed to call the API from a browser. The gateway
# no longer accepts "*": a wildcard lets any site on the internet script calls against
# this API from a visitor's browser and read the responses. Set this to your real
# frontend domain(s) in staging/production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# ── Proxy / rate limiting (gateway) ──────────────────────
# Set to true ONLY when the gateway sits behind a load balancer or reverse proxy that
# you control and that overwrites X-Forwarded-For. When true, the rate limiter keys on
# that header; when false (the default) it keys on the real TCP peer address.
# Enabling this while directly internet-exposed lets a client forge the header and
# bypass rate limiting entirely — including the tighter limit protecting /api/v1/auth.
APP_GATEWAY_TRUST_PROXY=false

# ── Upload Directory ─────────────────────────────────────
# MUST be an absolute path, and MUST be the same for every service. All six services
# write uploads here, but only hustleup-auth serves /uploads/** back to the browser
# (the gateway routes that path to port 8081). A relative path resolves against each
# process's own working directory, so anything uploaded via marketplace/social/
# notification would land in a directory the auth service can't see — the images then
# 404 in the UI even though the files exist on disk.
UPLOAD_DIR=C:/Users/You/hustleup/uploads

# ── Sentry (error monitoring — all 6 backend services) ────
SENTRY_DSN=
SENTRY_ENV=development

# ── Resend (transactional email — hustleup-auth, hustleup-marketplace) ─
RESEND_API_KEY=
EMAIL_FROM=HustleUp <notifications@hustleup.app>

# ── Google Sign-In (hustleup-auth) ────────────────────────
GOOGLE_CLIENT_ID=

# ── Facebook Login (hustleup-auth) ────────────────────────
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── Cloudflare Turnstile (bot protection on registration) ─
TURNSTILE_SECRET_KEY=

# ── Google Maps (geocoding sellers' cities + distance display) ─
GOOGLE_MAPS_SERVER_KEY=

# ── Algolia (search indexing — hustleup-marketplace) ──────
ALGOLIA_APP_ID=
ALGOLIA_ADMIN_KEY=

# ── CDN (optional — CloudFront in front of the S3 bucket above) ─
CDN_DOMAIN=
